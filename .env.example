# Google Gemini API Key for Multimodal Vision & Triage
GEMINI_API_KEY=

# PostgreSQL Database Connection URL (Local Dev on Port 5433)
DATABASE_URL="postgres://postgres:postgres@localhost:5433/surios"

# Email delivery: APP_ORIGIN, SMTP_HOST and SMTP_FROM enable notifications/recovery
APP_ORIGIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Optional exact browser-preview origins, comma-separated. Native apps need none.
# Example: http://localhost:8081,http://127.0.0.1:8081
API_ALLOWED_ORIGINS=
